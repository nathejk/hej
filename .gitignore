# Local secrets / per-developer Docker overrides (see docker-dev-stack skill).
docker-compose.override.yml

# Frontend dependencies (installed into a named volume in dev).
vue/node_modules/
vue/dist/

# Generated by unplugin-vue-components (auto-import type declarations).
vue/src/components.d.ts

# Scratch space for throwaway verification harnesses (e.g. task 036's
# service-worker update check: two built bundles, a served document root and a
# puppeteer script). Never a build input.
tmp/

# macOS Finder metadata. Unanchored so it matches at any depth — Finder creates
# one in every directory it displays.
.DS_Store
