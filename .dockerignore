# Keep the build context small and, more importantly, deterministic: the prod
# image must build identically from a fresh CI checkout and from a working tree
# that has already run the dev stack.
#
# Only `go/`, `vue/` and `docker/init/` are ever COPYed (see docker/Dockerfile) —
# everything else here is either generated, developer-local, or docs.

# VCS + editor/OS cruft. Note the Go build does not rely on .git: BUILD_VERSION
# is injected via -ldflags in the `build` stage precisely because the context has
# no VCS metadata.
.git
.gitignore
.DS_Store
*.log

# Docs, planning and agent config — never part of an image.
.agents
.github
.rules
roadmap

# Compose files, including the gitignored per-developer override that can carry
# local secrets.
docker-compose.yml
docker-compose.override.yml

# Frontend: deps live in a named volume in dev, and `ui-builder` runs its own
# `npm ci` + `npm run build`. Copying a host-built dist or node_modules in would
# risk shipping stale or platform-wrong artefacts.
vue/node_modules
vue/dist

# Generated by unplugin-vue-components during the Vite build.
vue/src/components.d.ts

# Generated OpenAPI spec (swaggo/swag); not imported by the build.
go/cmd/api/docs

# Dev-only placeholder web root. The prod stage populates /www from ui-builder.
go/www
